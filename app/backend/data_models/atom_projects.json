        "client_created_at": {
            "type": "integer",
            "format": "int64",
            "description": "客户端创建时间戳(毫秒)"
        },
        "client_updated_at": {
            "type": "integer",
            "format": "int64",
            "description": "客户端更新时间戳(毫秒)"
        }
