{
    "title": "atom_projects",
    "type": "object",
    "properties": {
        "id": {
            "type": "integer",
            "description": "自增主键"
        },
        "user_id": {
            "type": "string",
            "description": "所属用户"
        },
        "project_key": {
            "type": "string",
            "description": "本地项目唯一键"
        },
        "name": {
            "type": "string",
            "description": "项目名称"
        },
        "requirement": {
            "type": "string",
            "description": "原始需求文本"
        },
        "app_type": {
            "type": "string",
            "description": "应用类型 habit/todo/pomodoro/custom"
        },
        "status": {
            "type": "string",
            "description": "构建状态 building/done"
        },
        "building_at": {
            "type": "integer",
            "format": "int64",
            "description": "开始构建时间戳(毫秒)"
